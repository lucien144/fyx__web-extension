{
    "name": "fyx-for-web",
    "version": "1.0.0",
    "description": "Browser extension that simplifies the Nyx.cz interface and adds useful features.",
    "private": true,
    "type": "module",
    "packageManager": "pnpm@11.10.0",
    "scripts": {
        "dev": "wxt",
        "build": "wxt build",
        "zip": "wxt zip",
        "pack:local": "wxt zip && node scripts/tag-release.mjs",
        "postinstall": "wxt prepare",
        "compile": "tsc --noEmit",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "test": "vitest run",
        "test:watch": "vitest"
    },
    "author": "",
    "license": "ISC",
    "dependencies": {
        "markdown-it": "^15.0.0"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@types/markdown-it": "^14.1.2",
        "@types/node": "^24.13.3",
        "eslint": "^10.8.1",
        "eslint-config-prettier": "^10.1.8",
        "globals": "^17.11.0",
        "prettier": "^3.9.6",
        "sass": "^1.102.0",
        "typescript": "^5.9.0",
        "typescript-eslint": "^8.67.0",
        "vitest": "^4.1.10",
        "wxt": "^0.21.4"
    }
}
